# Nokia XG-040G-MF overlay: swap the pbs05 PON LuCI module for naoki66's ONU
# stack (voice page dropped) while leaving the shared release.config untouched
# so the XG2010G build keeps using luci-app-pon.
# CONFIG_PACKAGE_luci-app-pon is not set
# CONFIG_PACKAGE_luci-i18n-pon-zh-cn is not set
CONFIG_PACKAGE_luci-app-onu=y
CONFIG_PACKAGE_luci-i18n-onu-zh-cn=y
